@prefix agsmo: <https://w3id.org/agsmo/ns#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Example 04 — Full happy path: literature review plan (2 steps, first done)
# =============================================================================
# Teaching goal: end-to-end story a newcomer can narrate out loud.
#
# Narrative:
#   1. Agent opens episode "literature demo"
#   2. Creates plan "literature review" with two constraints
#   3. Decomposes into step0=search papers, step1=summarize
#   4. Executes step0 successfully with an explicit rationale
#   5. Leaves step1 open (next work item)
#
# Progress: 1/2 subgoals completed; root still "active"
# =============================================================================

agsmo:agent-default a agsmo:Agent , prov:Agent ;
    agsmo:description "Planning agent used in the offline literature-review demo" .

agsmo:episode-demo-1 a agsmo:Episode ;
    agsmo:description "Offline demo: plan a research literature review" ;
    agsmo:timestamp "2026-08-07T12:00:00Z"^^xsd:dateTime .

agsmo:constraint-peer-reviewed a agsmo:Constraint ;
    agsmo:description "Prefer peer-reviewed sources" ;
    agsmo:timestamp "2026-08-07T12:00:01Z"^^xsd:dateTime .

agsmo:constraint-time-box a agsmo:Constraint ;
    agsmo:description "Finish within 2 hours of agent time" ;
    agsmo:timestamp "2026-08-07T12:00:01Z"^^xsd:dateTime .

agsmo:goal-lit-review a agsmo:Goal ;
    agsmo:description "Complete a literature review on agentic memory systems" ;
    agsmo:status "active" ;
    agsmo:timestamp "2026-08-07T12:00:02Z"^^xsd:dateTime ;
    agsmo:partOfEpisode agsmo:episode-demo-1 ;
    agsmo:hasConstraint agsmo:constraint-peer-reviewed , agsmo:constraint-time-box ;
    agsmo:hasSubGoal agsmo:goal-search-papers , agsmo:goal-summarize .

agsmo:goal-search-papers a agsmo:SubGoal ;
    agsmo:description "Search recent papers on RDF memory for agents" ;
    agsmo:status "completed" ;
    agsmo:stepIndex 0 ;
    agsmo:timestamp "2026-08-07T12:00:03Z"^^xsd:dateTime ;
    agsmo:partOfEpisode agsmo:episode-demo-1 ;
    agsmo:achievedBy agsmo:action-search .

agsmo:goal-summarize a agsmo:SubGoal ;
    agsmo:description "Summarize key architectures and trade-offs" ;
    agsmo:status "active" ;
    agsmo:stepIndex 1 ;
    agsmo:timestamp "2026-08-07T12:00:03Z"^^xsd:dateTime ;
    agsmo:partOfEpisode agsmo:episode-demo-1 .

agsmo:action-search a agsmo:Action , prov:Activity ;
    agsmo:description "Queried open indexes for 'semantic memory agents RDF'" ;
    agsmo:rationale "Need a seed set of papers before summarizing architectures; prefer peer-reviewed sources per plan constraints" ;
    agsmo:timestamp "2026-08-07T12:05:00Z"^^xsd:dateTime ;
    agsmo:performedBy agsmo:agent-default ;
    agsmo:partOfEpisode agsmo:episode-demo-1 ;
    agsmo:hasOutcome agsmo:outcome-search-ok ;
    prov:wasAssociatedWith agsmo:agent-default .

agsmo:outcome-search-ok a agsmo:Outcome , prov:Entity ;
    agsmo:description "Found 12 candidate papers; 5 highly relevant" ;
    agsmo:success true ;
    agsmo:timestamp "2026-08-07T12:10:00Z"^^xsd:dateTime ;
    prov:wasGeneratedBy agsmo:action-search .
