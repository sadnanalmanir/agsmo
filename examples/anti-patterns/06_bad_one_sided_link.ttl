@prefix agsmo: <https://w3id.org/agsmo/ns#> .

# BAD (AGSMO 0.2): hasSubGoal without inverse subGoalOf.
# Dual-edge SHACL / writer contract requires both directions.

agsmo:agent-x a agsmo:Agent ; agsmo:description "demo agent" .

agsmo:plan-x a agsmo:Goal ;
  agsmo:description "Ship feature" ;
  agsmo:status "active" ;
  agsmo:hasSubGoal agsmo:step-a .

agsmo:step-a a agsmo:SubGoal ;
  agsmo:description "Design API" ;
  agsmo:status "active" ;
  agsmo:stepIndex 0 .
  # missing: agsmo:subGoalOf agsmo:plan-x
