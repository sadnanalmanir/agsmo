@prefix agsmo: <https://w3id.org/agsmo/ns#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

# BAD: Action is SHACL-valid (performer + dual performs) but not linked to any Goal.
# You cannot answer "in service of which goal?" — planning provenance is broken.

agsmo:agent-x a agsmo:Agent ; agsmo:description "demo agent" ;
  agsmo:performs agsmo:act-search .

agsmo:goal-search a agsmo:Goal ;
  agsmo:description "Find papers" ;
  agsmo:status "active" .

agsmo:act-search a agsmo:Action , prov:Activity ;
  agsmo:description "Queried the index" ;
  agsmo:rationale "Need candidates" ;
  agsmo:performedBy agsmo:agent-x .
  # missing: goal-search agsmo:achievedBy act-search (+ achieves)
