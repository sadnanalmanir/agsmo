@prefix agsmo: <https://w3id.org/agsmo/ns#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

# GOOD: Goal↔Action dual links (achievedBy/achieves) + outcome dual + performs.

agsmo:agent-x a agsmo:Agent ; agsmo:description "demo agent" ;
  agsmo:performs agsmo:act-search .

agsmo:goal-search a agsmo:Goal ;
  agsmo:description "Find papers" ;
  agsmo:status "completed" ;
  agsmo:achievedBy agsmo:act-search .

agsmo:act-search a agsmo:Action , prov:Activity ;
  agsmo:description "Queried the index" ;
  agsmo:rationale "Need candidates" ;
  agsmo:performedBy agsmo:agent-x ;
  agsmo:achieves agsmo:goal-search ;
  agsmo:hasOutcome agsmo:out-search .

agsmo:out-search a agsmo:Outcome , prov:Entity ;
  agsmo:description "Found 5 papers" ;
  agsmo:success true ;
  agsmo:outcomeOf agsmo:act-search ;
  prov:wasGeneratedBy agsmo:act-search .
