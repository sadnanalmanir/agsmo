@prefix agsmo: <https://w3id.org/agsmo/ns#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

# GOOD: Outcome records success flag.

agsmo:agent-x a agsmo:Agent ; agsmo:description "demo agent" .

agsmo:act-x a agsmo:Action , prov:Activity ;
  agsmo:description "Ran the suite" ;
  agsmo:performedBy agsmo:agent-x ;
  agsmo:hasOutcome agsmo:out-x .

agsmo:out-x a agsmo:Outcome , prov:Entity ;
  agsmo:description "Suite finished with issues" ;
  agsmo:success false ;
  prov:wasGeneratedBy agsmo:act-x .
