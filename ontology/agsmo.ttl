@prefix agsmo:  <https://w3id.org/agsmo/ns#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc:     <http://purl.org/dc/elements/1.1/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix bibo:   <http://purl.org/ontology/bibo/> .
@prefix sw:     <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix widoco: <https://w3id.org/widoco/vocab#> .

################################################################################
# Agent Semantic Memory Ontology (AGSMO) — v0.2.0
#
# Annotated for WIDOCO/LODE documentation best practices:
#   https://dgarijo.github.io/Widoco/doc/bestPractices/index-en.html
#   - vocabulary metadata (title, abstract, creators, license, versions, …)
#   - term labels, definitions, and skos:example / vann:example on every term
#
# Namespace: https://w3id.org/agsmo/ns#
# Prefix:    agsmo
# Not ASMO (Atomistic Simulation Methods Ontology).
#
# Writer contract (v0.2+): for every object-property link that has an inverse,
# instance graphs MUST assert BOTH directions. RDFLib does not materialize
# owl:inverseOf; one-sided writes break inverse SPARQL and SHACL dual-edge rules.
################################################################################

agsmo: a owl:Ontology ;
    owl:versionIRI <https://w3id.org/agsmo/ns/0.2#> ;
    owl:versionInfo "0.2.0" ;
    owl:priorVersion <https://w3id.org/agsmo/ns/0.1#> ;
    owl:imports <http://www.w3.org/ns/prov-o#> ;

    # --- Identity (WIDOCO recommended) ---
    dcterms:title "Agent Semantic Memory Ontology"@en ;
    rdfs:label "Agent Semantic Memory Ontology"@en ;
    schema:alternateName "AGSMO"@en ;
    dcterms:alternative "AGSMO"@en ;
    vann:preferredNamespacePrefix "agsmo" ;
    vann:preferredNamespaceUri "https://w3id.org/agsmo/ns#" ;

    # --- Abstract / description ---
    dcterms:abstract """AGSMO is a lightweight OWL vocabulary for the long-term semantic memory of AI agents.
It models goals and multi-step plans (as ordered goal trees), constraints, actions with rationales,
outcomes, episodes (sessions), and agents, with alignment to W3C PROV-O for provenance and
“why did you do X?” explainability."""@en ;

    dcterms:description """AGSMO (Agent Semantic Memory Ontology) provides classes and properties so that an agent's
work is stored as a queryable RDF knowledge graph rather than only as chat text or embeddings.

**What you can represent**
- High-level goals and ordered subgoals (a *plan* is a root Goal with SubGoals, not a separate class)
- Constraints that apply to a plan (budget, tools, policy, offline-only, …)
- Actions the agent took, with human-readable rationales
- Outcomes (success/failure) linked to actions
- Episodes that group work into sessions
- Agents that perform actions (aligned with prov:Agent)

**How to read an example**
See the repository file `examples/literature_review_plan.ttl` for a complete multi-step plan instance,
and the `skos:example` / `vann:example` annotations on each class and property below.

**Not to confuse with** ASMO — Atomistic Simulation Methods Ontology (materials science)."""@en ;

    rdfs:comment """Use prefix agsmo: for https://w3id.org/agsmo/ns#. Multi-step plans = root Goal + ordered SubGoals
(stepIndex) + optional Constraints; Actions/Outcomes hang primarily off the current SubGoal."""@en ;

    widoco:introduction """## Why AGSMO?

Most agents remember only chat transcripts or vector embeddings. AGSMO treats memory as
**structured knowledge**: goals, steps, rules, and decisions you can query and explain.

## Mental model (one picture)

```
Agent ──performs──► Action ──hasOutcome──► Outcome
  ▲         │          ▲          │
  └──performedBy───────┘    outcomeOf
                       ▲
                       │ achievedBy / achieves
Episode ◄──includes── Goal ──hasConstraint──► Constraint
   partOfEpisode         │         constrains
                         └──hasSubGoal / subGoalOf──► SubGoal (stepIndex)
```

A multi-step **plan** is a root Goal with ordered SubGoals — there is **no** separate Plan class.

## Bidirectional links (v0.2)

When you assert a forward object property that has an inverse, **also assert the inverse triple**.
Pairs: hasSubGoal↔subGoalOf, hasConstraint↔constrains, achievedBy↔achieves,
hasOutcome↔outcomeOf, performedBy↔performs, partOfEpisode↔includes.

## Learn with progressive examples

In the repository `examples/` folder (load each file *with* `ontology/agsmo.ttl`):

| File | Lesson |
|------|--------|
| `01_minimal_goal.ttl` | Smallest graph: Agent + Goal |
| `02_plan_with_constraints.ttl` | Plan structure + constraints + stepIndex |
| `03_action_and_explain.ttl` | Action, Outcome, rationale (“why?”) |
| `04_literature_review_full.ttl` | Full happy path (one step done, one open) |
| `05_failure_and_rollup.ttl` | Failed step → plan status failed |
| `queries.sparql` | Copy-paste SPARQL for the above |

Start at 01 and move up. Every class/property below also has a short `skos:example` and a Turtle `vann:example`.

## Tiny sketch

```turtle
@prefix agsmo: <https://w3id.org/agsmo/ns#> .
agsmo:agent-alice a agsmo:Agent ; agsmo:description "Assistant" .
agsmo:goal-x a agsmo:Goal ; agsmo:description "Do X" ; agsmo:status "active" .
```
"""@en ;

    # --- People ---
    dcterms:creator [
        a schema:Person , foaf:Person ;
        schema:name "Sadnan Al Manir" ;
        foaf:name "Sadnan Al Manir" ;
        schema:givenName "Sadnan" ;
        schema:familyName "Al Manir" ;
        schema:email "sadnanalmanir@gmail.com" ;
        foaf:mbox <mailto:sadnanalmanir@gmail.com> ;
        schema:url <https://github.com/sadnanalmanir>
    ] ;
    dcterms:creator "Sadnan Al Manir"@en ;

    # --- Dates / versioning ---
    dcterms:created "2026-08-07"^^xsd:date ;
    dcterms:issued "2026-08-07"^^xsd:date ;
    dcterms:modified "2026-08-08"^^xsd:date ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:rights "Copyright (c) 2026 Sadnan Al Manir. MIT License."@en ;
    bibo:status "Ontology Specification Draft"@en ;
    schema:creativeWorkStatus "Draft"@en ;

    # --- Links ---
    schema:codeRepository <https://github.com/sadnanalmanir/agsmo> ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ,
                 <https://sadnanalmanir.github.io/agsmo/> ,
                 <https://github.com/sadnanalmanir/agsmo> ,
                 <https://ocdo.github.io/asmo/> ;
    dcterms:bibliographicCitation "Al Manir, S. (2026). Agent Semantic Memory Ontology (AGSMO) 0.2.0. https://github.com/sadnanalmanir/agsmo"@en ;
    schema:citation "Al Manir, S. (2026). Agent Semantic Memory Ontology (AGSMO) 0.2.0. https://github.com/sadnanalmanir/agsmo"@en ;
    vann:example <https://github.com/sadnanalmanir/agsmo/blob/main/examples/README.md> ;
    vann:example <https://github.com/sadnanalmanir/agsmo/blob/main/examples/04_literature_review_full.ttl> ;
    skos:example "Progressive examples in the repository examples/ folder: start with 01_minimal_goal.ttl, then 02–05; full happy path is 04_literature_review_full.ttl; SPARQL in queries.sparql."@en .

################################################################################
# Classes
################################################################################

agsmo:MemoryEntity a owl:Class ;
    rdfs:label "Memory entity"@en ;
    skos:prefLabel "Memory entity"@en ;
    rdfs:comment "Abstract root class for resources stored in agent semantic memory (goals, constraints, actions, outcomes, episodes). Agents are modelled separately."@en ;
    skos:definition "Anything that is part of the agent's structured memory graph other than the Agent itself."@en ;
    skos:example "In the literature-review example, the root goal, each subgoal, each constraint, each action, each outcome, and the episode are all MemoryEntity instances."@en ;
    vann:example "agsmo:goal/lit-review a agsmo:Goal .  # Goal ⊑ MemoryEntity"@en ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" ;
    owl:disjointWith agsmo:Agent .

agsmo:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    skos:prefLabel "Agent"@en ;
    rdfs:comment "An autonomous actor (software agent or human-in-the-loop) that performs actions and pursues goals."@en ;
    skos:definition "Performer of agsmo:Action instances; subclass of prov:Agent."@en ;
    skos:example "A CLI planning agent identified as agsmo:agent/default-agent with description \"Semantic Memory Agent\"."@en ;
    vann:example """agsmo:agent/default-agent a agsmo:Agent , prov:Agent ;
  agsmo:description \"Planning agent used in the offline demo\" ."""@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:Goal a owl:Class ;
    rdfs:label "Goal"@en ;
    skos:prefLabel "Goal"@en ;
    rdfs:comment """A desired state or objective the agent is working toward.
A multi-step *plan* is modelled as a root Goal that has ordered SubGoal children
(via hasSubGoal + stepIndex). There is no separate Plan class."""@en ;
    skos:definition "An objective that may be decomposed into subgoals, constrained by rules, and advanced by actions."@en ;
    skos:example "Root goal: \"Complete a literature review on agentic memory systems\" with status active and two constraints (peer-reviewed sources; finish within 2 hours)."@en ;
    vann:example """agsmo:goal/lit-review a agsmo:Goal ;
  agsmo:description \"Complete a literature review on agentic memory systems\" ;
  agsmo:status \"active\" ;
  agsmo:hasConstraint agsmo:constraint/peer-reviewed ;
  agsmo:hasSubGoal agsmo:goal/search-papers , agsmo:goal/summarize ."""@en ;
    rdfs:subClassOf agsmo:MemoryEntity ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:SubGoal a owl:Class ;
    rdfs:label "Sub-goal"@en ;
    skos:prefLabel "Sub-goal"@en ;
    rdfs:comment "A goal that is part of a larger goal or plan. When used in ordered multi-step plans, it should carry agsmo:stepIndex (0-based)."@en ;
    skos:definition "A Goal that is linked from a parent Goal via hasSubGoal."@en ;
    skos:example "Step 0 of a plan: \"Search recent papers on RDF memory for agents\" with stepIndex 0 and status completed after a successful action."@en ;
    vann:example """agsmo:goal/search-papers a agsmo:SubGoal ;
  agsmo:description \"Search recent papers on RDF memory for agents\" ;
  agsmo:status \"completed\" ;
  agsmo:stepIndex 0 ."""@en ;
    rdfs:subClassOf agsmo:Goal ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    skos:prefLabel "Constraint"@en ;
    rdfs:comment "A rule, limit, or preference the agent must respect while pursuing a goal (budget, allowed tools, policy, style, offline-only, …). Typically attached to the root plan goal."@en ;
    skos:definition "A normative or practical restriction associated with one or more goals."@en ;
    skos:example "\"Prefer peer-reviewed sources\" and \"Finish within 2 hours of agent time\" attached to the literature-review root goal."@en ;
    vann:example """agsmo:constraint/peer-reviewed a agsmo:Constraint ;
  agsmo:description \"Prefer peer-reviewed sources\" .
agsmo:goal/lit-review agsmo:hasConstraint agsmo:constraint/peer-reviewed ."""@en ;
    rdfs:subClassOf agsmo:MemoryEntity ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:Action a owl:Class ;
    rdfs:label "Action"@en ;
    skos:prefLabel "Action"@en ;
    rdfs:comment "Something the agent did or attempted. Instance data should also type it as prov:Activity and record a rationale when possible."@en ;
    skos:definition "A performed (or attempted) activity in service of a goal, optionally with explainable rationale."@en ;
    skos:example "Action: \"Queried open indexes for 'semantic memory agents RDF'\" with rationale explaining why a seed paper set was needed before summarizing."@en ;
    vann:example """agsmo:action/search a agsmo:Action , prov:Activity ;
  agsmo:description \"Queried open indexes for 'semantic memory agents RDF'\" ;
  agsmo:rationale \"Need a seed set of papers before summarizing architectures\" ;
  agsmo:performedBy agsmo:agent/default-agent ;
  prov:wasAssociatedWith agsmo:agent/default-agent .
agsmo:goal/search-papers agsmo:achievedBy agsmo:action/search ."""@en ;
    rdfs:subClassOf agsmo:MemoryEntity , prov:Activity ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:Outcome a owl:Class ;
    rdfs:label "Outcome"@en ;
    skos:prefLabel "Outcome"@en ;
    rdfs:comment "Result of an action. Instance data should also type it as prov:Entity and link with prov:wasGeneratedBy back to the action."@en ;
    skos:definition "The recorded result of an Action, including whether it succeeded."@en ;
    skos:example "Outcome: \"Found 12 candidate papers; 5 highly relevant\" with success true, generated by the search action."@en ;
    vann:example """agsmo:outcome/search-ok a agsmo:Outcome , prov:Entity ;
  agsmo:description \"Found 12 candidate papers; 5 highly relevant\" ;
  agsmo:success true ;
  prov:wasGeneratedBy agsmo:action/search .
agsmo:action/search agsmo:hasOutcome agsmo:outcome/search-ok ."""@en ;
    rdfs:subClassOf agsmo:MemoryEntity , prov:Entity ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:Episode a owl:Class ;
    rdfs:label "Episode"@en ;
    skos:prefLabel "Episode"@en ;
    rdfs:comment "A coherent session or window of work that groups goals and actions (e.g. one chat session or one offline demo run)."@en ;
    skos:definition "A temporal work context that goals and actions may be part of."@en ;
    skos:example "Episode: \"Offline demo: plan a research literature review\" timestamped at the start of the demo session."@en ;
    vann:example """agsmo:episode/demo-1 a agsmo:Episode ;
  agsmo:description \"Offline demo: plan a research literature review\" ;
  agsmo:timestamp \"2026-08-07T12:00:00Z\"^^xsd:dateTime .
agsmo:goal/lit-review agsmo:partOfEpisode agsmo:episode/demo-1 ."""@en ;
    rdfs:subClassOf agsmo:MemoryEntity ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:GoalStatus a owl:Class ;
    rdfs:label "Goal status"@en ;
    skos:prefLabel "Goal status"@en ;
    rdfs:comment """Controlled concept documenting allowed lifecycle values for goals.
Instance data commonly stores status as an xsd:string on agsmo:status
('active' | 'completed' | 'failed' | 'abandoned') for simple tooling; these
individuals document the same controlled set."""@en ;
    skos:definition "A SKOS-style concept representing a goal lifecycle state."@en ;
    skos:example "The string \"completed\" on a subgoal after its action succeeded corresponds to the individual agsmo:statusCompleted."@en ;
    vann:example "agsmo:goal/search-papers agsmo:status \"completed\" .  # same meaning as agsmo:statusCompleted"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:statusActive a agsmo:GoalStatus ;
    rdfs:label "active"@en ;
    skos:prefLabel "active"@en ;
    skos:notation "active" ;
    skos:definition "The goal is open and may still receive work."@en ;
    skos:example "A newly created plan root goal starts with status \"active\"."@en ;
    rdfs:isDefinedBy agsmo: .

agsmo:statusCompleted a agsmo:GoalStatus ;
    rdfs:label "completed"@en ;
    skos:prefLabel "completed"@en ;
    skos:notation "completed" ;
    skos:definition "The goal was achieved successfully."@en ;
    skos:example "After all plan subgoals are completed, the root plan status becomes \"completed\"."@en ;
    rdfs:isDefinedBy agsmo: .

agsmo:statusFailed a agsmo:GoalStatus ;
    rdfs:label "failed"@en ;
    skos:prefLabel "failed"@en ;
    skos:notation "failed" ;
    skos:definition "The goal ended unsuccessfully."@en ;
    skos:example "If a critical subgoal fails and no open steps remain, the parent plan may roll up to \"failed\"."@en ;
    rdfs:isDefinedBy agsmo: .

agsmo:statusAbandoned a agsmo:GoalStatus ;
    rdfs:label "abandoned"@en ;
    skos:prefLabel "abandoned"@en ;
    skos:notation "abandoned" ;
    skos:definition "Work on the goal was stopped without success or failure being claimed."@en ;
    skos:example "A user cancels a plan mid-way; open subgoals may be marked \"abandoned\"."@en ;
    rdfs:isDefinedBy agsmo: .

################################################################################
# Object properties
#
# Writer contract (AGSMO 0.2+): every pair below is dual-asserted in instance
# data. If you write the forward edge, MUST also write the inverse edge (and
# vice versa). Tools without an OWL reasoner will not invent the missing side.
################################################################################

agsmo:hasSubGoal a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has sub-goal"@en ;
    skos:prefLabel "has sub-goal"@en ;
    rdfs:comment """Decomposes a goal into a child goal. Ordered multi-step plans pair this with agsmo:stepIndex on each child.
MUST also assert the inverse agsmo:subGoalOf on the child (AGSMO 0.2 writer contract)."""@en ;
    skos:definition "Relates a parent goal to one of its subgoals."@en ;
    skos:example "Root literature-review goal hasSubGoal search-papers and summarize."@en ;
    vann:example """agsmo:goal/lit-review agsmo:hasSubGoal agsmo:goal/search-papers .
agsmo:goal/search-papers agsmo:subGoalOf agsmo:goal/lit-review ."""@en ;
    rdfs:domain agsmo:Goal ;
    rdfs:range agsmo:Goal ;
    owl:inverseOf agsmo:subGoalOf ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:subGoalOf a owl:ObjectProperty ;
    rdfs:label "sub-goal of"@en ;
    skos:prefLabel "sub-goal of"@en ;
    rdfs:comment """Inverse of hasSubGoal. REQUIRED in instance data whenever hasSubGoal is asserted
(AGSMO 0.2+; RDF stores do not auto-materialize owl:inverseOf)."""@en ;
    skos:definition "Relates a child goal to its parent goal."@en ;
    skos:example "search-papers is a subGoalOf lit-review."@en ;
    vann:example "agsmo:goal/search-papers agsmo:subGoalOf agsmo:goal/lit-review ."@en ;
    rdfs:domain agsmo:Goal ;
    rdfs:range agsmo:Goal ;
    owl:inverseOf agsmo:hasSubGoal ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:hasConstraint a owl:ObjectProperty ;
    rdfs:label "has constraint"@en ;
    skos:prefLabel "has constraint"@en ;
    rdfs:comment """Associates a constraint with a goal (usually the root plan goal so all steps inherit the rule conceptually).
MUST also assert agsmo:constrains from the constraint to the goal (AGSMO 0.2)."""@en ;
    skos:definition "Links a goal to a constraint that should guide work on that goal."@en ;
    skos:example "lit-review hasConstraint peer-reviewed and time-box."@en ;
    vann:example """agsmo:goal/lit-review agsmo:hasConstraint agsmo:constraint/peer-reviewed .
agsmo:constraint/peer-reviewed agsmo:constrains agsmo:goal/lit-review ."""@en ;
    rdfs:domain agsmo:Goal ;
    rdfs:range agsmo:Constraint ;
    owl:inverseOf agsmo:constrains ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    skos:prefLabel "constrains"@en ;
    rdfs:comment """Inverse of hasConstraint. REQUIRED whenever hasConstraint is asserted (AGSMO 0.2)."""@en ;
    skos:definition "Relates a constraint to a goal that it governs."@en ;
    skos:example "peer-reviewed constrains lit-review."@en ;
    vann:example "agsmo:constraint/peer-reviewed agsmo:constrains agsmo:goal/lit-review ."@en ;
    rdfs:domain agsmo:Constraint ;
    rdfs:range agsmo:Goal ;
    owl:inverseOf agsmo:hasConstraint ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:achievedBy a owl:ObjectProperty ;
    rdfs:label "achieved by"@en ;
    skos:prefLabel "achieved by"@en ;
    rdfs:comment """Links a goal to an action taken in service of that goal (typically the current subgoal).
MUST also assert agsmo:achieves from the action to the goal (AGSMO 0.2)."""@en ;
    skos:definition "Relates a goal to an action performed toward achieving it."@en ;
    skos:example "Subgoal search-papers was achievedBy action/search."@en ;
    vann:example """agsmo:goal/search-papers agsmo:achievedBy agsmo:action/search .
agsmo:action/search agsmo:achieves agsmo:goal/search-papers ."""@en ;
    rdfs:domain agsmo:Goal ;
    rdfs:range agsmo:Action ;
    owl:inverseOf agsmo:achieves ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:achieves a owl:ObjectProperty ;
    rdfs:label "achieves"@en ;
    skos:prefLabel "achieves"@en ;
    rdfs:comment """Inverse of achievedBy. REQUIRED whenever achievedBy is asserted (AGSMO 0.2).
Enables Action → Goal navigation for explainability without scanning reverse links."""@en ;
    skos:definition "Relates an action to a goal it was performed to advance."@en ;
    skos:example "action/search achieves search-papers."@en ;
    vann:example "agsmo:action/search agsmo:achieves agsmo:goal/search-papers ."@en ;
    rdfs:domain agsmo:Action ;
    rdfs:range agsmo:Goal ;
    owl:inverseOf agsmo:achievedBy ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:hasOutcome a owl:ObjectProperty ;
    rdfs:label "has outcome"@en ;
    skos:prefLabel "has outcome"@en ;
    rdfs:comment """Links an action to its outcome. Prefer also asserting prov:wasGeneratedBy from the outcome to the action.
MUST also assert agsmo:outcomeOf on the outcome (AGSMO 0.2)."""@en ;
    skos:definition "Relates an action to a recorded outcome."@en ;
    skos:example "action/search hasOutcome outcome/search-ok."@en ;
    vann:example """agsmo:action/search agsmo:hasOutcome agsmo:outcome/search-ok .
agsmo:outcome/search-ok agsmo:outcomeOf agsmo:action/search ."""@en ;
    rdfs:domain agsmo:Action ;
    rdfs:range agsmo:Outcome ;
    owl:inverseOf agsmo:outcomeOf ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:outcomeOf a owl:ObjectProperty ;
    rdfs:label "outcome of"@en ;
    skos:prefLabel "outcome of"@en ;
    rdfs:comment """Inverse of hasOutcome. REQUIRED whenever hasOutcome is asserted (AGSMO 0.2)."""@en ;
    skos:definition "Relates an outcome to the action that produced it."@en ;
    skos:example "outcome/search-ok is an outcomeOf action/search."@en ;
    vann:example "agsmo:outcome/search-ok agsmo:outcomeOf agsmo:action/search ."@en ;
    rdfs:domain agsmo:Outcome ;
    rdfs:range agsmo:Action ;
    owl:inverseOf agsmo:hasOutcome ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    skos:prefLabel "performed by"@en ;
    rdfs:comment """Agent that performed the action. Aligns with (and is a sub-property of) prov:wasAssociatedWith.
MUST also assert agsmo:performs from the agent to the action (AGSMO 0.2)."""@en ;
    skos:definition "Relates an action to the agent that carried it out."@en ;
    skos:example "action/search was performedBy agent/default-agent."@en ;
    vann:example """agsmo:action/search agsmo:performedBy agsmo:agent/default-agent .
agsmo:agent/default-agent agsmo:performs agsmo:action/search ."""@en ;
    rdfs:domain agsmo:Action ;
    rdfs:range agsmo:Agent ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    owl:inverseOf agsmo:performs ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:performs a owl:ObjectProperty ;
    rdfs:label "performs"@en ;
    skos:prefLabel "performs"@en ;
    rdfs:comment """Inverse of performedBy. REQUIRED whenever performedBy is asserted (AGSMO 0.2)."""@en ;
    skos:definition "Relates an agent to an action it carried out."@en ;
    skos:example "default-agent performs action/search."@en ;
    vann:example "agsmo:agent/default-agent agsmo:performs agsmo:action/search ."@en ;
    rdfs:domain agsmo:Agent ;
    rdfs:range agsmo:Action ;
    owl:inverseOf agsmo:performedBy ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:partOfEpisode a owl:ObjectProperty ;
    rdfs:label "part of episode"@en ;
    skos:prefLabel "part of episode"@en ;
    rdfs:comment """Places a goal or action in a session/episode.
MUST also assert agsmo:includes from the episode to the member (AGSMO 0.2)."""@en ;
    skos:definition "Relates a goal or action to the episode in which it occurred."@en ;
    skos:example "Both the root goal and the search action are partOfEpisode demo-1."@en ;
    vann:example """agsmo:goal/lit-review agsmo:partOfEpisode agsmo:episode/demo-1 .
agsmo:episode/demo-1 agsmo:includes agsmo:goal/lit-review ."""@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( agsmo:Goal agsmo:Action )
    ] ;
    rdfs:range agsmo:Episode ;
    owl:inverseOf agsmo:includes ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:includes a owl:ObjectProperty ;
    rdfs:label "includes"@en ;
    skos:prefLabel "includes"@en ;
    rdfs:comment """Inverse of partOfEpisode. REQUIRED whenever partOfEpisode is asserted (AGSMO 0.2).
Lists goals and actions that belong to an episode."""@en ;
    skos:definition "Relates an episode to a goal or action that is part of that session."@en ;
    skos:example "episode demo-1 includes lit-review and action/search."@en ;
    vann:example "agsmo:episode/demo-1 agsmo:includes agsmo:goal/lit-review , agsmo:action/search ."@en ;
    rdfs:domain agsmo:Episode ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( agsmo:Goal agsmo:Action )
    ] ;
    owl:inverseOf agsmo:partOfEpisode ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

################################################################################
# Datatype properties
################################################################################

agsmo:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    skos:prefLabel "description"@en ;
    rdfs:comment "Human-readable text describing a memory entity or agent."@en ;
    skos:definition "Primary natural-language label content for a resource."@en ;
    skos:example "description \"Complete a literature review on agentic memory systems\" on the root goal."@en ;
    vann:example "agsmo:goal/lit-review agsmo:description \"Complete a literature review on agentic memory systems\" ."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( agsmo:MemoryEntity agsmo:Agent )
    ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp"@en ;
    skos:prefLabel "timestamp"@en ;
    rdfs:comment "Creation or event time in UTC as xsd:dateTime."@en ;
    skos:definition "When the resource or event was recorded."@en ;
    skos:example "Episode timestamp \"2026-08-07T12:00:00Z\"."@en ;
    vann:example "agsmo:episode/demo-1 agsmo:timestamp \"2026-08-07T12:00:00Z\"^^xsd:dateTime ."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( agsmo:MemoryEntity agsmo:Agent )
    ] ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    skos:prefLabel "status"@en ;
    rdfs:comment """Lifecycle status of a goal as a controlled string.
Allowed values used by the reference tooling: \"active\", \"completed\", \"failed\", \"abandoned\".
See also the GoalStatus individuals for the same vocabulary."""@en ;
    skos:definition "String encoding of a goal's lifecycle state."@en ;
    skos:example "agsmo:status \"active\" on a new plan; \"completed\" after all steps succeed."@en ;
    vann:example "agsmo:goal/search-papers agsmo:status \"completed\" ."@en ;
    rdfs:domain agsmo:Goal ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:success a owl:DatatypeProperty ;
    rdfs:label "success"@en ;
    skos:prefLabel "success"@en ;
    rdfs:comment "Whether an outcome is considered successful (xsd:boolean)."@en ;
    skos:definition "Boolean success flag on an Outcome."@en ;
    skos:example "success true on outcome/search-ok."@en ;
    vann:example "agsmo:outcome/search-ok agsmo:success true ."@en ;
    rdfs:domain agsmo:Outcome ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:stepIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step index"@en ;
    skos:prefLabel "step index"@en ;
    rdfs:comment "0-based order of a subgoal within a multi-step plan. Gives a stable next-open-step ordering."@en ;
    skos:definition "Integer position of a subgoal in plan order, starting at 0."@en ;
    skos:example "search-papers has stepIndex 0; summarize has stepIndex 1."@en ;
    vann:example "agsmo:goal/search-papers agsmo:stepIndex 0 ."@en ;
    rdfs:domain agsmo:Goal ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .

agsmo:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale"@en ;
    skos:prefLabel "rationale"@en ;
    rdfs:comment "Why an action was chosen (explainability). Prefer this property over rdfs:comment for action rationales."@en ;
    skos:definition "Natural-language justification for selecting an action."@en ;
    skos:example "rationale \"Need a seed set of papers before summarizing architectures\" on the search action."@en ;
    vann:example "agsmo:action/search agsmo:rationale \"Need a seed set of papers before summarizing architectures\" ."@en ;
    rdfs:domain agsmo:Action ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy agsmo: ;
    sw:term_status "stable" .
